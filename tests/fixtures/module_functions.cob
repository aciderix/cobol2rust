      * Fonctions intrinsèques du module, du pointeur et du calcul :
      * SIGN, COMBINED-DATETIME, CONTENT-LENGTH, CONTENT-OF, MODULE-*.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. module-functions.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 P USAGE POINTER.
       01 X PIC X(8) VALUE Z"HELLO".
       01 Y PIC X(4) VALUE LOW-VALUE.
       01 F USAGE FLOAT-LONG VALUE -2.5.
       01 N PIC S9(3)V9 VALUE -0.0.
       01 D PIC 9(8).
       01 T PIC 9(6).
       01 R PIC X(20).
       PROCEDURE DIVISION.
           DISPLAY FUNCTION SIGN (3.5) " " FUNCTION SIGN (-0.001)
               " " FUNCTION SIGN (0) " " FUNCTION SIGN (F)
               " " FUNCTION SIGN (N)
           DISPLAY FUNCTION COMBINED-DATETIME (987, 345.6)
           DISPLAY FUNCTION COMBINED-DATETIME (1, 86400)
           DISPLAY FUNCTION COMBINED-DATETIME (0, 1)
           DISPLAY FUNCTION EXCEPTION-STATUS
           DISPLAY FUNCTION COMBINED-DATETIME (1, 1)
           DISPLAY "[" FUNCTION EXCEPTION-STATUS "]"
           DISPLAY FUNCTION COMBINED-DATETIME (1, 86400.5)
           DISPLAY FUNCTION EXCEPTION-STATUS
           SET P TO ADDRESS OF X
           DISPLAY FUNCTION CONTENT-LENGTH (P) " ["
               FUNCTION CONTENT-OF (P) "] [" FUNCTION CONTENT-OF (P, 3)
               "] [" FUNCTION CONTENT-OF (P) (2:3) "]"
           DISPLAY "[" FUNCTION EXCEPTION-STATUS "]"
           SET P TO ADDRESS OF Y
           DISPLAY FUNCTION CONTENT-LENGTH (P)
           DISPLAY FUNCTION EXCEPTION-STATUS
           SET P TO NULL
           MOVE "unchanged" TO R
           STRING FUNCTION CONTENT-OF (P) DELIMITED BY SIZE INTO R
           DISPLAY R
           DISPLAY FUNCTION EXCEPTION-STATUS
           DISPLAY FUNCTION MODULE-ID " ["
               FUNCTION MODULE-CALLER-ID "]"
           MOVE FUNCTION MODULE-DATE TO D
           MOVE FUNCTION MODULE-TIME TO T
           IF D > 20000000 AND T IS NUMERIC
              AND FUNCTION LENGTH (FUNCTION MODULE-FORMATTED-DATE) = 20
              AND FUNCTION MODULE-PATH NOT = SPACES
              AND FUNCTION SECONDS-PAST-MIDNIGHT < 86400
              DISPLAY "clock ok"
           END-IF
           CALL "INNER"
           STOP RUN.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. INNER.
       PROCEDURE DIVISION.
           DISPLAY FUNCTION MODULE-ID " [" FUNCTION MODULE-CALLER-ID "]"
           GOBACK.
       END PROGRAM INNER.
       END PROGRAM module-functions.
